#cloud-config
package_update: true
packages:
  - nginx
  - docker

write_files:
  - path: /etc/nginx/sites-available/my-site.conf
    permissions: "0644"
    content: |
      server {
        listen 80;
        server_name _;
        location /api/ {
            proxy_pass http://127.0.0.1:5000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location / {
            proxy_pass http://127.0.0.1:5001; 
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
      }

  - path: /home/ec2-user/app/docker-compose.yml
    permissions: "0644"
    content: |
      services:
        backend:
          image: docker.io/${docker_username}/duties-api-backend:latest
          container_name: duties-api-backend
          ports:
            - "5000:5000"
          restart: always
          environment:
            - DATABASE_URL=${database_url}

        frontend:
          image: docker.io/${docker_username}/duties-api-frontend:latest
          container_name: duties-api-frontend
          ports:
            - "5001:5000"
          restart: always
          environment:
            - BACKEND_URL=http://backend:5000
          depends_on:
            - backend

runcmd:
  - ln -sf /etc/nginx/sites-available/my-site.conf /etc/nginx/sites-enabled/
  - rm -f /etc/nginx/sites-enabled/default
  - systemctl restart nginx

  - systemctl start docker
  - systemctl enable docker
  - usermod -aG docker ec2-user

  - mkdir -p /usr/libexec/docker/cli-plugins
  - curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m) -o /usr/libexec/docker/cli-plugins/docker-compose
  - chmod +x /usr/libexec/docker/cli-plugins/docker-compose

  - timeout 60s bash -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
  - cd /home/ec2-user/app && docker compose pull
  - cd /home/ec2-user/app && docker compose up -d
