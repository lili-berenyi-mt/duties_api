#cloud-config
package_update: true
packages:
  - nginx
  - docker

write_files:
  - path: /etc/nginx/sites-available/my-site.conf
    permissions: "0644"
    content: |
      server {
        listen 80;
        server_name _;
        location /api/ {
            proxy_pass http://127.0.0.1:5000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location / {
            proxy_pass http://127.0.0.1:5001; 
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
      }

runcmd:
  - sleep 10
  - ln -sf /etc/nginx/sites-available/my-site.conf /etc/nginx/sites-enabled/
  - rm -f /etc/nginx/sites-enabled/default
  - systemctl restart nginx
  - systemctl start docker
  - systemctl enable docker
  - timeout 60s bash -c 'until docker info >/dev/null 2>&1; do echo "waiting for docker..."; sleep 2; done'

  - |
    for i in {1..5}; do docker pull ${docker_username}/duties-api-backend:latest && break || sleep 10; done
  - sudo docker stop duties-api-backend || true
  - sudo docker rm duties-api-backend || true
  - sudo docker run -d \
    -p 5000:5000 \
    --name duties-api-backend \
    --restart always \
    -e DATABASE_URL="${database_url}" \
    docker.io/${docker_username}/duties-api-backend:latest

  - |
    for i in {1..5}; do docker pull ${docker_username}/duties-api-frontend:latest && break || sleep 10; done
  - sudo docker stop duties-api-frontend || true
  - sudo docker rm duties-api-frontend || true
  - sudo docker run -d -p 5001:5000 --name duties-api-frontend docker.io/${docker_username}/duties-api-frontend:latest
